<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="${basedir}/nlog-internal.log">

    <targets async="false">
        <target name="file1" xsi:type="File"  fileName="/opt/logs/${shortdate}.log"
                layout="${longdate}|${level:uppercase=true:padding=-5}|${event-properties:traceid}|${logger}|${message:withexception=true}" />
        <target name="console1" xsi:type="ColoredConsole" 
                layout="${time} ${level:uppercase=true:padding=-5} [${event-properties:traceid}] ${logger} ${message}" />
    </targets>

    <rules>
        <logger name="*" minlevel="Info" writeTo="file1" />
        <logger name="*" minlevel="Debug" writeTo="console1" />
    </rules>
</nlog>
